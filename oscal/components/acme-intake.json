        "type": "software",
        "title": "acme-health-patient-intake",
        "description": "Patient Intake API (fork of cgep-app-starter) plus the GRC baseline: customer CMK, Object Lock evidence vault, multi-region CloudTrail, gap-closing Terraform overrides, HIPAA Rego gate, and Cosign-signed evidence on every green pipeline run.",
        "purpose": "Make the telehealth intake workload audit-defensible under the HIPAA Security Rule without slowing engineering merges.",
        "responsible-roles": [
          {
            "role-id": "provider",
            "party-uuids": [
              "f277760e-9092-4d40-943d-a131976f3f0c"
            ]
          }
        ],
