                "control-id": "hipaa-164-312-a-2-iv",
                "description": "Encryption and decryption (addressable). PHI at rest on the uploads bucket and DynamoDB table is encrypted with customer CMK aws_kms_key.phi (rotation enabled). Closes GAP-01 and GAP-02 in Terraform; Rego packages compliance.hipaa.s3_cmk and compliance.hipaa.ddb_cmk refuse plans that drop the CMK.",
                "props": [
                  {
                    "name": "hipaa-citation",
                    "value": "164.312(a)(2)(iv)"
                  },
                  {
                    "name": "implementation-status",
                    "value": "implemented"
                  },
                  {
                    "name": "gap",
                    "value": "GAP-01"
                  },
                  {
                    "name": "gap",
                    "value": "GAP-02"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_kms_key.phi"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_s3_bucket_server_side_encryption_configuration.uploads"
                  },
                  {
                    "name": "terraform-resource",
                    "value": "aws_dynamodb_table.intake"
                  }
